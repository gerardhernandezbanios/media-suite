# Ruta al disco externo montado por Docker Desktop
MEDIA_DISK=/host_mnt/d/Gerard

# Rutas internas dentro del contenedor
SOURCE_DIR=/data/incoming
IMAGES_ROOT=/data/Images
VIDEOS_ROOT=/data/Video
ANIMATIONS_ROOT=/data/Animation
UNSUPPORTED_ROOT=/data/unsupported
DUPLICATES_ROOT=/data/duplicates

LOG_FILE=/data/logs/file_movements.csv
AUDIT_FILE=/data/logs/audit_summary.csv

# --- BASE DE DATOS ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=media_suite
DB_USER=media
DB_PASSWORD=media

# URL completa para SQLAlchemy async
DB_URL=postgresql+asyncpg://media:media@postgres:5432/media_suite
