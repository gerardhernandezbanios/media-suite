{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ingestor",
      "type": "debugpy",
      "request": "launch",
      "module": "ingestor.main",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/infra/.env",
      "cwd": "${workspaceFolder}/services/ingestor",
      "justMyCode": true
    },
    {
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-s", "tests"],
      "cwd": "${workspaceFolder}/services/ingestor",
      "console": "integratedTerminal",
      "justMyCode": true
    }

  ]
}
