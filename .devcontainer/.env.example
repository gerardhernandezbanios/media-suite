# Ruta del HOST con los vídeos e imágenes. Se monta en /data/media dentro del contenedor.
# Copia este fichero a ".env" (mismo directorio) y ajusta el valor a tu equipo.
#
# Windows: usa barras normales, no invertidas
#   MEDIA_PATH=D:/Gerard
# Linux / macOS:
#   MEDIA_PATH=/home/usuario/media
#
# Si no lo defines, se usa ./data/media dentro del repo (ignorada por git).
MEDIA_PATH=D:/Gerard