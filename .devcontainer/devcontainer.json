{
  "name": "media-suite",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "pip install poetry && poetry config virtualenvs.in-project true",
  "postStartCommand": "/bin/bash /workspaces/media-suite/.devcontainer/load-env.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "charliermarsh.ruff",
        "ms-python.black-formatter",
        "ms-python.mypy-type-checker",
        "editorconfig.editorconfig"
      ]
    }
  },
  "containerEnv": {
    "ENV_FILE": "/workspaces/media-suite/infra/.env"
  },
  "remoteUser": "vscode"
}
